# 비교용 이미지. 실제 배포에는 쓰지 않는다. (D24)
#
# "멀티 스테이지가 낫다"는 말을 숫자 없이 쓰고 싶지 않아서 만들었다.
# 흔히 처음 작성하는 형태 그대로다. JDK 위에 fat jar 하나를 얹는다.
#
#   docker build -f infra/Dockerfile.single-stage -t shop-api:naive .
#
# 이 방식의 문제는 두 가지다.
#   1. 최종 이미지에 JDK가 통째로 남는다. 컴파일러와 개발 도구가 실행에는 필요 없다
#   2. jar가 레이어 하나다. 코드 한 줄만 고쳐도 전체가 새 레이어가 된다
#
# 측정 결과는 docs/06-roadmap.md에 있다.

FROM eclipse-temurin:21-jdk-alpine

WORKDIR /app

# 빌드 도구와 소스가 전부 이미지에 남는다.
COPY . .

RUN chmod +x gradlew && ./gradlew bootJar --no-daemon -x test

EXPOSE 8080

# root로 실행된다. 기본값을 그대로 둔 결과다.
ENTRYPOINT ["sh", "-c", "java -jar build/libs/*.jar"]
