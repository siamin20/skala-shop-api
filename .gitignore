# Java / Gradle
build/
.gradle/
# Eclipse·IDE 빌드 산출물. Gradle의 build/와 별개로 생긴다.
bin/
*.class
*.log

# 빌드 산출물 jar는 무시하되 Gradle Wrapper는 커밋한다
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Node
node_modules/
dist/
*.local
# Vite가 의존성을 미리 묶어두는 캐시. 매 실행마다 이름이 바뀌는 임시 폴더가 생긴다.
.vite/

# 환경변수
.env
.env.*
!.env.example

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# 설계 문서와 작업 규칙은 로컬에만 두고 커밋하지 않는다
docs/
# Eclipse·VS Code 자바 확장이 만드는 컴파일 산출물.
# Gradle의 build/와 같은 성격인데 경로만 다르다.
bin/

# 로컬 작업 규칙 묶음. AGENTS.md가 여기를 가리킨다.
.local/

AGENTS.md
CLAUDE.md
CONTRIBUTING.md

# 보고서 생성 도구와 산출물.
#
# 입력이 docs/captures/ 인데 그 폴더가 커밋 대상이 아니라, 이것만 올려두면
# 받아간 사람이 돌릴 수 없는 스크립트가 된다. 제출 산출물이지 소스가 아니므로 함께 뺀다.
tools/
*.docx
web/capture*.mjs
web/render-term.mjs
