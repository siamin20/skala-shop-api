# Java / Gradle
build/
.gradle/
# Eclipse·IDE 빌드 산출물. Gradle의 build/와 별개로 생긴다.
bin/
*.class
*.log

# 빌드 산출물 jar는 무시하되 Gradle Wrapper는 커밋한다
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Node
node_modules/
dist/
*.local
# Vite가 의존성을 미리 묶어두는 캐시. 매 실행마다 이름이 바뀌는 임시 폴더가 생긴다.
.vite/

# 환경변수
.env
.env.*
!.env.example

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# 설계 문서와 작업 규칙은 로컬에만 두고 커밋하지 않는다
docs/
# Eclipse·VS Code 자바 확장이 만드는 컴파일 산출물.
# Gradle의 build/와 같은 성격인데 경로만 다르다.
bin/

# 개인 작업 환경과 보고서 생성 도구는 .git/info/exclude 에 둔다.
# 저장소가 각자의 개발 환경까지 설명할 이유가 없고,
# 사람마다 다른 항목이 쌓이면 이 파일이 금방 지저분해진다.
