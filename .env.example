# 애플리케이션
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/skalashop
DATABASE_USERNAME=skalashop
DATABASE_PASSWORD=skalashop
POSTGRES_PORT=5432

# Redis (선착순 이벤트 카운터)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (32바이트 이상의 임의 문자열, 실제 값은 커밋하지 않는다)
JWT_SECRET=
JWT_EXPIRATION=3600

# 신규 가입 시 지급 포인트
SIGNUP_INITIAL_POINT=1000000
