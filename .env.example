# 애플리케이션
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/skalashop
DATABASE_USERNAME=skalashop
DATABASE_PASSWORD=skalashop
POSTGRES_PORT=5432

# Redis (선착순 이벤트 카운터)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (32바이트 이상의 임의 문자열, 실제 값은 커밋하지 않는다)
JWT_SECRET=
JWT_ACCESS_VALIDITY=15m
JWT_REFRESH_VALIDITY=14d

# 관리자 계정. 둘 다 설정해야 기동 시 생성된다.
# 설정하지 않으면 관리자 계정이 만들어지지 않는다.
SHOP_ADMIN_ID=
SHOP_ADMIN_PASSWORD=

# 신규 가입 시 지급 포인트
SIGNUP_INITIAL_POINT=1000000
